# LeadPilot web app (Vite). Copy to .env.local and fill in. Only VITE_* variables reach the browser,
# so never put secret keys here.

# Base URL of the Hono API Worker (without /api/v1).
VITE_API_URL=http://localhost:8787

# Supabase project URL and *publishable* key (sb_publishable_…), used for Auth only.
# Leave both empty to run the read-only portfolio preview without sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
